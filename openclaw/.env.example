COMPOSE_PROJECT_NAME=openclaw

TZ=UTC

# Pin to a current OpenClaw release — see ghcr.io/openclaw/openclaw tags.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.2.26
OPENCLAW_HOST=openclaw.example.com

# Optional: model as provider/model-id. Default openai/gpt-4.1 is set in docker-compose;
# uncomment to override (e.g. openai/gpt-4o, openai/gpt-4o-mini, anthropic/claude-...).
# OPENCLAW_MODEL=openai/gpt-4.1

# Optional: trusted reverse-proxy source for trusted-proxy gateway auth. Default is the
# openclaw-edge subnet (set in docker-compose); override only if that subnet differs.
# OPENCLAW_TRUSTED_PROXIES=172.30.0.0/16

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token

# Your numeric Telegram user id (e.g. from @userinfobot) — the only DM the bot answers.
TELEGRAM_OWNER_ID=change-me-numeric-telegram-id
