{
  // OpenClaw configuration (JSON5 — comments + trailing commas allowed).
  // Mounted read-only; secrets are interpolated from container env at read time.
  agents: {
    defaults: {
      model: {
        // Deployment-configurable via OPENCLAW_MODEL (provider/model-id); default
        // openai/gpt-4o is set in docker-compose. The provider credential (API key /
        // token) is seeded once into the openclaw-data volume via `make onboard-openclaw`.
        primary: "${OPENCLAW_MODEL}",
      },
      // v1: the unprivileged, host-isolated container IS the jail; main runs in-process
      // inside it. Escalation (sandbox.mode "all" + a profile-gated executor) is deferred.
      sandbox: {
        mode: "off",
      },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      // Long-poll by default → no public inbound webhook is exposed.
      botToken: "${TELEGRAM_BOT_TOKEN}",
      // Single-owner bot: recognize the owner directly by numeric Telegram user id,
      // instead of the default "pairing" policy that would silently ignore your first
      // messages until a pairing code is approved out-of-band.
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_OWNER_ID}"],
    },
  },
  gateway: {
    // "lan" = bind 0.0.0.0 inside the container so Traefik (on openclaw-edge) reaches :18789.
    bind: "lan",
    port: 18789,
    // Trust Traefik on the dedicated openclaw-edge subnet (OPENCLAW_TRUSTED_PROXIES via
    // the compose env). Lets the gateway accept the proxy-forwarded auth headers.
    trustedProxies: ["${OPENCLAW_TRUSTED_PROXIES}"],
    controlUi: {
      // REQUIRED for a non-loopback bind (verified at runtime — this is Codex's P1):
      // the gateway refuses to start unless the browser origin (the Traefik host) is
      // explicitly allowlisted. ${OPENCLAW_HOST} is injected via the compose env block.
      allowedOrigins: ["https://${OPENCLAW_HOST}"],
    },
    auth: {
      // Delegate auth to the trusted reverse proxy (Traefik on openclaw-edge); the gateway
      // reads the authenticated user from the Remote-User header Authelia forwards. No
      // separate gateway token needed — Authelia (password+TOTP) gates the UI.
      mode: "trusted-proxy",
      trustedProxy: {
        userHeader: "Remote-User",
      },
    },
    tools: {
      // Hard-disable the browser tool at the HTTP layer.
      deny: ["browser"],
    },
  },
  browser: {
    // Belt-and-suspenders — browser binaries are not installed in the image anyway.
    enabled: false,
  },
  // Runaway-loop / subscription-protection knobs. OpenClaw has NO per-task max-iterations;
  // the subscription's own rate-limit is the real ceiling. Verify exact key nesting against
  // docs.openclaw.ai/gateway/configuration-reference before enabling these:
  // cron: { maxConcurrentRuns: 2, retry: { maxAttempts: 3 }, failureAlert: { enabled: true, after: 3 } },
  // acp: { maxConcurrentSessions: 2, sessionIdleTtlMs: 600000 },
}
