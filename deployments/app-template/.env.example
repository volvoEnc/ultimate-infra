COMPOSE_PROJECT_NAME=app-template-prod
APP_NAME=app-template
APP_ENV=prod
PROXY_NETWORK=proxy
DATA_NETWORK=data
APP_IMAGE=ghcr.io/example/app-template:1.0.0
WORKER_IMAGE=ghcr.io/example/app-template-worker:1.0.0
CRON_IMAGE=ghcr.io/example/app-template-cron:1.0.0
APP_ENV_FILE=../../env/prod/app-template.env
APP_HOST=app-template.example.com
APP_URL=https://app-template.example.com/health
APP_PORT=3000
APP_HEALTHCHECK_PATH=/health
APP_DATA_PATH=/var/lib/app
WORKER_COMMAND=node worker.js
CRON_COMMAND=supercronic /etc/supercronic/app.cron
