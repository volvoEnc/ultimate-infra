TZ=UTC
PROXY_NETWORK=proxy
DATA_NETWORK=data

CENTRIFUGO_HOST=realtime.example.com
CENTRIFUGO_EXTERNAL_PORT=8000
CENTRIFUGO_INTERNAL_PORT=8001
CENTRIFUGO_LOG_LEVEL=info

# Set the browser origin of your frontend. If you need more than one origin,
# use Centrifugo's space-separated string array format.
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://app.example.com

# Replace both secrets before production usage.
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=change-me-client-token-secret
CENTRIFUGO_HTTP_API_KEY=change-me-http-api-key

# Internal-only admin UI is optional. If you enable it, set a strong password.
CENTRIFUGO_ADMIN_ENABLED=false
CENTRIFUGO_ADMIN_PASSWORD=change-me-admin-password

CENTRIFUGO_HEALTH_ENABLED=true
CENTRIFUGO_PROMETHEUS_ENABLED=true
