COMPOSE_PROJECT_NAME=authelia

TZ=UTC
DATA_NETWORK=data
PROXY_NETWORK=proxy

# Pin to a current Authelia 4.38+ release (4.38+ provides /api/authz/forward-auth
# and the identity_validation reset-password JWT key path used here).
AUTHELIA_IMAGE=authelia/authelia:4.39.5
AUTHELIA_HOST=auth.example.com

# Generate each secret with:
#   docker run --rm authelia/authelia:4.39.5 authelia crypto rand --length 64 --charset alphanumeric
AUTHELIA_SESSION_SECRET=change-me-session-secret
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-storage-encryption-key
# Only used if you enable password reset (password_reset.disable: false). Inert otherwise.
AUTHELIA_JWT_SECRET=change-me-jwt-secret

# MUST be byte-for-byte identical to REDIS_PASSWORD in redis/.env (Redis requirepass is
# server-wide). Authelia sessions live in infra-redis DB index 2; redis-ui uses DB 0.
# Rotating Redis auth means editing BOTH redis/.env and this file, then restarting the
# redis, redis-ui and authelia containers.
REDIS_PASSWORD=change-me-must-equal-redis-env-REDIS_PASSWORD
